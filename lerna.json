{
  "packages": [
    "packages/*"
  ],
  "version": "0.0.0",
  "npmClient": "npm",
  "useWorkspaces": true,
  "command": {
    "version": {
      "conventionalCommits": true,
      "changelogPreset": "conventionalcommits",
      "message": "chore(release): publish %s"
    },
    "publish": {
      "message": "chore(release): publish %s",
      "registry": "https://registry.npmjs.org"
    },
    "bootstrap": {
      "hoist": true
    }
  }
}
